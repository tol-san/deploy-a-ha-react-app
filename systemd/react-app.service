[Unit]
Description=React Vite application
After=network.target

[Service]
Type=simple
User=vagrant
WorkingDirectory=/vagrant/react-app
Environment=PATH=/home/vagrant/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/vagrant/.bun/bin/bun --bun node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target